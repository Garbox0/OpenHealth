OPENHEALTH_APP_NAME=OpenHealth Bridge
OPENHEALTH_ENVIRONMENT=local
OPENHEALTH_DATABASE_URL=sqlite+aiosqlite:///./openhealth_bridge_local.db
OPENHEALTH_DATABASE_ECHO=false
OPENHEALTH_FRONTEND_ORIGINS=https://www.aerosftp.com
OPENHEALTH_REQUIRE_AUTH=true
OPENHEALTH_OIDC_ISSUER_URL=http://127.0.0.1:8081/realms/openhealth
OPENHEALTH_OIDC_JWKS_URL=
OPENHEALTH_OIDC_CLIENT_ID=openhealth-dev

# Docker Compose local: copiar este archivo a .env y completar valores privados.
POSTGRES_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
OPENHEALTH_USER_ADMIN_PASSWORD=
OPENHEALTH_USER_ADMISSION_PASSWORD=
OPENHEALTH_USER_AUDITOR_PASSWORD=
OPENHEALTH_USER_BILLING_PASSWORD=
OPENHEALTH_USER_DOCTOR_PASSWORD=
OPENHEALTH_USER_SUPPORT_PASSWORD=
