{
  "realm": "openhealth",
  "enabled": true,
  "displayName": "Central Salud",
  "displayNameHtml": "Central Salud",
  "loginTheme": "openhealth",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "permanentLockout": false,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "administrative" },
      { "name": "doctor" }
    ]
  },
  "groups": [
    {
      "name": "Administrativos",
      "realmRoles": ["administrative"]
    },
    {
      "name": "Medicos",
      "realmRoles": ["doctor"]
    },
    {
      "name": "IT",
      "realmRoles": ["admin"]
    }
  ],
  "clients": [
    {
      "clientId": "openhealth-dev",
      "name": "OpenHealth Dev Client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "rootUrl": "https://www.aerosftp.com",
      "baseUrl": "https://www.aerosftp.com/backoffice/",
      "redirectUris": [
        "https://www.aerosftp.com/",
        "https://www.aerosftp.com/backoffice/*",
        "https://www.aerosftp.com/medicos/*",
        "https://www.aerosftp.com/seguridad/*",
        "https://centralsalud.aerosftp.com/",
        "https://centralsalud.aerosftp.com/backoffice/*",
        "https://centralsalud.aerosftp.com/medicos/*",
        "https://centralsalud.aerosftp.com/seguridad/*"
      ],
      "webOrigins": [
        "https://www.aerosftp.com",
        "https://centralsalud.aerosftp.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://www.aerosftp.com/##https://www.aerosftp.com/backoffice/*##https://www.aerosftp.com/medicos/*##https://www.aerosftp.com/seguridad/*##https://centralsalud.aerosftp.com/##https://centralsalud.aerosftp.com/backoffice/*##https://centralsalud.aerosftp.com/medicos/*##https://centralsalud.aerosftp.com/seguridad/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@openhealth.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "OpenHealth",
      "realmRoles": ["admin"],
      "groups": ["/IT"]
    },
    {
      "username": "administrative",
      "enabled": true,
      "email": "administrative@openhealth.local",
      "emailVerified": true,
      "firstName": "Administrativo",
      "lastName": "OpenHealth",
      "realmRoles": ["administrative"],
      "groups": ["/Administrativos"]
    },
    {
      "username": "doctor",
      "enabled": true,
      "email": "doctor@openhealth.local",
      "emailVerified": true,
      "firstName": "Doctor",
      "lastName": "OpenHealth",
      "realmRoles": ["doctor"],
      "groups": ["/Medicos"]
    }
  ]
}
